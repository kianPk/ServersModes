<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.373" PrivateAssets="all" ExcludeAssets="runtime" />
    <Compile Include="$(MSBuildThisFileDirectory)src/Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
